@model IEnumerable<Gasto>

@{
    ViewData["Title"] = "Mis gastos";
    var gastos = Model.ToList();
}

<div class="page-header">
    <div>
        <h1>Mis gastos</h1>
        <p>Aquí puedes administrar tus gastos personales: revisa, registra, edita o elimina cada movimiento.</p>
    </div>
    <a asp-action="Create" class="btn btn--primary">+ Nuevo gasto</a>
</div>

<div class="summary-card">
    <div>
        <p class="label">Total de gastos</p>
        <p class="amount">S/ @ViewBag.Total.ToString("N2")</p>
    </div>
    <p class="count">@gastos.Count gasto@(gastos.Count == 1 ? "" : "s") registrado@(gastos.Count == 1 ? "" : "s")</p>
</div>

@if (!gastos.Any())
{
    <div class="empty-state">
        <h2>Todavía no registraste ningún gasto</h2>
        <p>Usa el botón "+ Nuevo gasto" para anotar el primero.</p>
        <a asp-action="Create" class="btn btn--primary">+ Nuevo gasto</a>
    </div>
}
else
{
    <table class="ledger-table">
        <thead>
            <tr>
                <th>Descripción</th>
                <th>Categoría</th>
                <th>Fecha</th>
                <th class="amount">Monto</th>
                <th class="actions">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in gastos)
            {
                <tr>
                    <td class="desc" data-label="Descripción"><span class="cell-value">@item.Descripcion</span></td>
                    <td data-label="Categoría">
                        <span class="cell-value"><span class="tag tag--@(item.Categoria.ToString().ToLowerInvariant())">@Html.DisplayFor(modelItem => item.Categoria)</span></span>
                    </td>
                    <td class="date" data-label="Fecha"><span class="cell-value">@item.Fecha.ToString("dd/MM/yyyy")</span></td>
                    <td class="amount" data-label="Monto"><span class="cell-value">S/ @item.Monto.ToString("N2")</span></td>
                    <td class="actions">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn--ghost btn--sm">Ver</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn--ghost btn--sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn--ghost btn--sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
