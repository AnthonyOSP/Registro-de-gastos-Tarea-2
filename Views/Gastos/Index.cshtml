@model GastosIndexViewModel

@{
    ViewData["Title"] = "Mis gastos";
    // Activa el layout de pantalla completa (ver site.css, sección 13): en
    // pantallas anchas la página deja de crecer más allá de la ventana y solo
    // la lista de gastos hace scroll interno si no entra completa.
    ViewData["BodyClass"] = "dashboard-page";
}

<div class="page-header">
    <div class="page-header-text">
        <h1>Mis gastos</h1>
        <p>Aquí puedes administrar tus gastos personales: revisa, registra, edita o elimina cada movimiento.</p>
    </div>
    <a asp-action="Create" class="btn btn--primary" data-modal-target="modal-nuevo-gasto">+ Nuevo gasto</a>
</div>

<!-- Modal de "nuevo gasto": se abre con JS (dialog.showModal()) en vez de
     navegar a /Gastos/Create. Si JavaScript no está disponible, el enlace de
     arriba igual funciona y navega normalmente a esa página (data-modal-target
     no tiene efecto sin JS). El formulario se envía tal cual a GastosController
     igual que si estuviera en su propia página: si hay errores de validación,
     el navegador termina en la página completa de Crear (con el mismo
     formulario) en vez de reabrir el modal — evita tener que reimplementar la
     validación por AJAX. -->
<dialog id="modal-nuevo-gasto" class="app-modal">
    <div class="modal-box form-card">
        <div class="modal-head">
            <h2>Registrar gasto</h2>
            <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">&times;</button>
        </div>
        <form asp-controller="Gastos" asp-action="Create">
            <partial name="_CrearGastoForm" model="null" />
            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Guardar</button>
                <button type="button" class="btn btn--ghost" data-modal-close>Cancelar</button>
            </div>
        </form>
    </div>
</dialog>

@if (!Model.HayGastosRegistrados)
{
    <div class="empty-state">
        <h2>No tienes gastos registrados todavía.</h2>
        <p>Empieza a llevar el control de tus gastos personales.</p>
        <a asp-action="Create" class="btn btn--primary" data-modal-target="modal-nuevo-gasto">Registrar mi primer gasto</a>
    </div>
    return;
}

<div class="dashboard-grid">
    <!-- Columna izquierda: resumen. Estas cifras se calculan sobre TODOS los
         gastos, no solo los filtrados. -->
    <aside class="dashboard-side">
        <div class="summary-card">
            <div>
                <p class="label">Total gastado</p>
                <p class="amount">S/ @Model.Total.ToString("N2")</p>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <p class="label">Cantidad de gastos</p>
                <p class="stat-amount">@Model.Cantidad</p>
            </div>
            <div class="stat-card">
                <p class="label">Mayor gasto</p>
                <p class="stat-amount">S/ @Model.MayorGasto.ToString("N2")</p>
            </div>
            <div class="stat-card">
                <p class="label">Gasto promedio</p>
                <p class="stat-amount">S/ @Model.Promedio.ToString("N2")</p>
            </div>
        </div>

        <section class="category-summary">
            <h2>Gastos por categoría</h2>
            <div class="category-list">
                @foreach (var item in Model.ResumenPorCategoria)
                {
                    <div class="category-row">
                        <div class="category-row-top">
                            <span class="tag tag--@(item.Categoria.ToString().ToLowerInvariant())">@Html.DisplayFor(modelItem => item.Categoria)</span>
                            <span class="category-amount">S/ @item.Total.ToString("N2")</span>
                        </div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: @item.Porcentaje.ToString("0.#", CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </div>
                }
            </div>
        </section>
    </aside>

    <!-- Columna derecha: filtros + la lista de gastos (esta sí filtrada). -->
    <div class="dashboard-main">
        <!-- Filtros: formulario GET sencillo, sin JavaScript. Los valores actuales
             quedan en la URL (?busqueda=...&categoria=...&fecha=...), así que se
             pueden compartir o recargar sin perderse. -->
        <form asp-action="Index" method="get" class="filter-bar">
            <div class="field">
                <label asp-for="Busqueda">Buscar</label>
                <input asp-for="Busqueda" placeholder="Ej. almuerzo" />
            </div>
            <div class="field">
                <label for="Categoria">Categoría</label>
                <select name="Categoria" id="Categoria">
                    <option value="" selected="@(Model.Categoria.HasValue ? null : "selected")">Todas</option>
                    @foreach (var opcion in Model.OpcionesCategoria)
                    {
                        <option value="@opcion.Value" selected="@(Model.Categoria?.ToString() == opcion.Value ? "selected" : null)">@opcion.Text</option>
                    }
                </select>
            </div>
            <div class="field">
                <label asp-for="Fecha">Fecha</label>
                <input asp-for="Fecha" type="date" />
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn btn--primary btn--sm">Filtrar</button>
                @if (Model.HayFiltrosActivos)
                {
                    <a asp-action="Index" class="btn btn--ghost btn--sm">Limpiar filtros</a>
                }
            </div>
        </form>

        @if (!Model.Gastos.Any())
        {
            <div class="empty-state">
                <h2>No encontramos gastos con estos filtros.</h2>
                <p>Prueba con otra descripción, categoría o fecha.</p>
                <a asp-action="Index" class="btn btn--primary">Limpiar filtros</a>
            </div>
        }
        else
        {
            <table class="ledger-table">
                <thead>
                    <tr>
                        <th>Descripción</th>
                        <th>Categoría</th>
                        <th>Fecha</th>
                        <th class="amount">Monto</th>
                        <th class="actions">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Gastos)
                    {
                        <tr>
                            <td class="desc" data-label="Descripción"><span class="cell-value">@item.Descripcion</span></td>
                            <td data-label="Categoría">
                                <span class="cell-value"><span class="tag tag--@(item.Categoria.ToString().ToLowerInvariant())">@Html.DisplayFor(modelItem => item.Categoria)</span></span>
                            </td>
                            <td class="date" data-label="Fecha"><span class="cell-value">@item.Fecha.ToString("dd/MM/yyyy")</span></td>
                            <td class="amount" data-label="Monto"><span class="cell-value">S/ @item.Monto.ToString("N2")</span></td>
                            <td class="actions">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn--ghost btn--sm">Ver</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn--ghost btn--sm">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn--ghost btn--sm">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
