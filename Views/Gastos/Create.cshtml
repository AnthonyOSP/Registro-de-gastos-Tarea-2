@model Gasto

@{
    ViewData["Title"] = "Registrar gasto";
}

<div class="page-narrow">
    <div class="page-header">
        <div class="page-header-text">
            <h1>Registrar gasto</h1>
            <p>Anota un nuevo movimiento de tu registro personal.</p>
        </div>
    </div>

    <div class="form-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert-error"></div>

            <div class="field">
                <label asp-for="Descripcion"></label>
                <input asp-for="Descripcion" autofocus />
                <span asp-validation-for="Descripcion"></span>
            </div>

            <div class="field">
                <label asp-for="Monto"></label>
                <input asp-for="Monto" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Monto"></span>
            </div>

            <div class="field">
                <label asp-for="Categoria"></label>
                <select asp-for="Categoria" asp-items="Html.GetEnumSelectList<CategoriaGasto>()"></select>
                <span asp-validation-for="Categoria"></span>
            </div>

            <div class="field">
                <label asp-for="Fecha"></label>
                <input asp-for="Fecha" type="date" />
                <span asp-validation-for="Fecha"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Guardar</button>
                <a asp-action="Index" class="btn btn--ghost">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
