@model Gasto

@{
    ViewData["Title"] = "Detalle del gasto";
}

<div class="page-header">
    <div>
        <h1>Detalle del gasto</h1>
        <p>Información completa de este movimiento.</p>
    </div>
</div>

<div class="detail-card">
    <dl>
        <div class="detail-row">
            <dt>Descripción</dt>
            <dd>@Model.Descripcion</dd>
        </div>
        <div class="detail-row">
            <dt>Monto</dt>
            <dd class="amount">S/ @Model.Monto.ToString("N2")</dd>
        </div>
        <div class="detail-row">
            <dt>Categoría</dt>
            <dd><span class="tag tag--@(Model.Categoria.ToString().ToLowerInvariant())">@Html.DisplayFor(m => m.Categoria)</span></dd>
        </div>
        <div class="detail-row">
            <dt>Fecha</dt>
            <dd>@Model.Fecha.ToString("dd/MM/yyyy")</dd>
        </div>
    </dl>

    <div class="detail-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn--primary">Editar</a>
        <a asp-action="Index" class="btn btn--ghost">Volver a gastos</a>
    </div>
</div>
