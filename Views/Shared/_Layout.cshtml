<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mis Gastos</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
    <!-- Se mantiene por compatibilidad con Home/Privacy/Error, que aún usan sus
         clases utilitarias (text-center, display-4, text-danger) y no forman
         parte de esta fase. Las vistas de Gastos y el layout ya no dependen de
         Bootstrap: usan las clases propias definidas en site.css. -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <header class="site-header">
        <div class="wrap">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">Mis Gastos</a>

            @{
                var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
            }
            <ul class="nav-links">
                <li>
                    <a asp-area="" asp-controller="Home" asp-action="Index"
                       class="@(controladorActual == "Home" ? "is-active" : "")">Inicio</a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Gastos" asp-action="Index"
                       class="@(controladorActual == "Gastos" ? "is-active" : "")">Gastos</a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Gastos" asp-action="Create" class="btn btn--primary btn--sm btn--pill">+ Nuevo gasto</a>
                </li>
            </ul>
        </div>
    </header>

    <main class="page">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="wrap">
            &copy; 2026 Mis Gastos — Tarea 2, USMP
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
